# Public canonical URL used for metadata, sitemap and structured data.
# Confirm the production domain before launch.
NEXT_PUBLIC_SITE_URL=https://yokbangun.id

# Optional: external backend base URL. When empty, the built-in Route Handlers
# under /api are used (same-origin).
NEXT_PUBLIC_API_BASE_URL=

# Optional: where form submissions are forwarded (CRM, email relay, n8n, etc.).
# When empty, submissions are validated and logged on the server only.
CONTACT_WEBHOOK_URL=
PARTNERSHIP_WEBHOOK_URL=

# Optional public contact details shown on the site. Leave empty to hide them.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_WHATSAPP=
